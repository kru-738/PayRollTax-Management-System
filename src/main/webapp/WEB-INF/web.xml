<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>PayrollTaxSystem</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.xhtml</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.xhtml</welcome-file>
  </welcome-file-list>
  
   <context-param>
  		<param-name>dbDriver</param-name>
  		<param-value>com.mysql.cj.jdbc.Driver</param-value>
  </context-param>
  
   <context-param>
  		<param-name>dbUrl</param-name>
  		<param-value>jdbc:mysql://localhost:3306/payrolldb</param-value>
  </context-param>
  
  <context-param>
  		<param-name>dbUser</param-name>
  		<param-value>root</param-value>
  </context-param>
  
   <context-param>
  		<param-name>dbPass</param-name>
  		<param-value>INDIA@11</param-value>
  </context-param>
  
  <servlet>
  		<servlet-name>Payroll</servlet-name>
  		<jsp-file>/payroll.jsp</jsp-file>
  		
  		
  		<init-param>
  			<param-name>taxRate</param-name>
  			<param-value>0.15</param-value>
  		</init-param>
  </servlet>
  
  <servlet-mapping>
  		<servlet-name>Payroll</servlet-name>
  		<url-pattern>/payroll</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>UpdateProcess</servlet-name>
    <jsp-file>/updateProcess.jsp</jsp-file>
    <init-param>
        <param-name>taxRate</param-name>
        <param-value>0.15</param-value>
    </init-param>
</servlet>
<servlet-mapping>
    <servlet-name>UpdateProcess</servlet-name>
    <url-pattern>/updateProcess</url-pattern>
</servlet-mapping>
  
</web-app>